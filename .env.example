# Firebase Web API key（サーバー専用。Identity Toolkit REST 用）
# Firebase コンソール > プロジェクト設定 > 一般 > Web API キー
FIREBASE_WEB_API_KEY=

# Firebase Admin（server-only — never commit real values）
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Use literal \n for line breaks when storing in a single line
FIREBASE_ADMIN_PRIVATE_KEY=
